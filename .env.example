# Database
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password

# Application security
DJANGO_SECRET_KEY=change-this-django-secret
JWT_SECRET=change-this-shared-jwt-secret

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Frontend/API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP / Email notifications
# Mailpit is the default local SMTP server. Open http://localhost:8025 to read emails.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=0
SMTP_SSL=0
SMTP_FROM=Ledgerly Security <no-reply@ledgerly.local>

# OPTIONAL: real Gmail SMTP (replace the Mailpit values above). Use a Google App Password, not your normal Gmail password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-digit-app-password
# SMTP_TLS=1
# SMTP_SSL=0
# SMTP_FROM=your-email@gmail.com

# Django uses the same SMTP settings for security notifications.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Ledgerly Security <no-reply@ledgerly.local>

# Copy to .env to override the defaults used by docker-compose.yml
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments_pass
DB_ROOT_PASSWORD=root_pass
DJANGO_SECRET_KEY=change-this-django-secret-key-in-production-0123456789
DJANGO_DEBUG=0
# Must be identical for Django and FastAPI (FastAPI verifies tokens issued by Django)
JWT_SECRET=change-this-shared-jwt-secret-in-production-0123456789
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

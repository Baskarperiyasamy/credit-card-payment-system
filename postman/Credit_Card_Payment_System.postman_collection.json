        {
          "name": "Activate user 2",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/users/2/"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "List all cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/cards/"
            }
          }
        },
        {
          "name": "List all transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/transactions/?status=FAILED"
            }
          }
        },
        {
          "name": "Export transactions CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/transactions/export/"
            }
          }
        },
        {
          "name": "Daily payment summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/summary/"
            }
          }
        },
        {
          "name": "Admin logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/logs/"
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard (FastAPI)",
      "description": "Run '1. Authentication > Login (user)' first so {{access_token}} is set.",
      "item": [
        {
          "name": "Dashboard summary (valid JWT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{fastapi_url}}/dashboard/summary"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('has all summary fields', () => {",
                  "  ['total_transactions','total_amount_spent','current_month_spending','available_credit_limit','last_5_transactions']",
                  "    .forEach(k => pm.expect(d).to.have.property(k));",
                  "});",
                  "pm.test('numbers look right', () => {",
                  "  pm.expect(d.total_transactions).to.be.a('number');",
                  "  pm.expect(Number(d.total_amount_spent)).to.be.at.least(0);",
                  "  pm.expect(Number(d.current_month_spending)).to.be.at.most(Number(d.total_amount_spent));",
                  "  pm.expect(Number(d.available_credit_limit)).to.be.at.least(0);",
                  "});",
                  "pm.test('last_5_transactions has at most 5 items with the right fields', () => {",
                  "  pm.expect(d.last_5_transactions.length).to.be.at.most(5);",
                  "  d.last_5_transactions.forEach(t => {",
                  "    ['amount','masked_card_number','date','status'].forEach(k => pm.expect(t).to.have.property(k));",
                  "    pm.expect(['PENDING','SUCCESS','FAILED']).to.include(t.status);",
                  "  });",
                  "});",
                  "pm.test('newest transaction first', () => {",
                  "  const dates = d.last_5_transactions.map(t => new Date(t.date).getTime());",
                  "  pm.expect(dates).to.eql([...dates].sort((a, b) => b - a));",
                  "});",
                  "pm.test('response time under 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard summary (no token -> 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fastapi_url}}/dashboard/summary"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without token', () => pm.response.to.have.status(401));",
                  "pm.test('error message', () => pm.expect(pm.response.json().detail).to.eql('Invalid or missing token.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard summary (invalid token -> 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-valid-jwt"
              }
            ],
            "url": {
              "raw": "{{fastapi_url}}/dashboard/summary"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with a bad token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
